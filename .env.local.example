# Copie pra .env.local e preencha. NÃO comite o .env.local (já está no .gitignore).

# ── Supabase ──────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# ── Mercado Pago ──────────────────────────────────────────
# Teste: TEST-... | Produção: APP_USR-...
MERCADOPAGO_ACCESS_TOKEN=
NEXT_PUBLIC_MERCADOPAGO_PUBLIC_KEY=

# ── Email (Resend) ────────────────────────────────────────
# Sem a key, o app roda em MOCK (loga e salva preview em /tmp). Com a key, envia.
RESEND_API_KEY=
EMAIL_FROM=Movva <noreply@movva.com.br>
EMAIL_REPLY_TO=contato@movva.com.br

# ── WhatsApp ──────────────────────────────────────────────
# Só dígitos com DDI (ex.: 5541991146161). MOVVA cai pra NICOLE se vazio.
WHATSAPP_NUMBER_NICOLE=5541991146161
WHATSAPP_NUMBER_MOVVA=

# ── App ───────────────────────────────────────────────────
# Base URL pros links absolutos nos emails (sem barra no fim).
NEXT_PUBLIC_APP_URL=https://project-vker8.vercel.app

# ── Cron (lembrete 24h) ───────────────────────────────────
# Segredo pra proteger o endpoint /api/cron/reminders-24h (Bearer).
CRON_SECRET=
